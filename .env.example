DOMAIN=dl.example.com
ACME_EMAIL=me@example.com
RATE_LIMIT_PER_MIN=30

# --- Telegram bot (optional) ---
# Leave TELEGRAM_TOKEN empty to run the web app only.
# Start the bot with: docker compose --profile bot up -d
TELEGRAM_TOKEN=
# Comma-separated numeric user ids allowed to use the bot. Empty = anyone.
TELEGRAM_ALLOWED_IDS=
